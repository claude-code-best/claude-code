{
	"version": "0.2.0",
	"inputs": [
		{
			"id": "inspectUrl",
			"type": "promptString",
			"description": "Paste the ws:// URL printed by bun run dev:inspect"
		}
	],
	"configurations": [
		{
			"type": "bun",
			"request": "attach",
			"name": "Attach to Claude Code",
			"url": "${input:inspectUrl}",
			"stopOnEntry": false,
			"internalConsoleOptions": "neverOpen"
		}
	]
}
